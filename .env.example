# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api

# Database Connection (Replica Set required for MongoDB Transactions)
# Local Replica Set or MongoDB Atlas M0 cluster
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/pg_owner_dev?retryWrites=true&w=majority

# Authentication
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_characters_long
JWT_EXPIRES_IN=30d

# Client & CORS
CLIENT_URL=*

# Scheduled Invoicing Secret (for Cron endpoint authentication)
INTERNAL_CRON_SECRET=replace_with_a_high_entropy_secret_for_cron_jobs

# Cloudinary (Private asset storage for KYC Documents)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

